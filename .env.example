# Copy to .env and adjust before `docker compose up`.

# MariaDB
MARIADB_DATABASE=pmsys
MARIADB_USER=pmsys
MARIADB_PASSWORD=pmsys_secret
MARIADB_ROOT_PASSWORD=root_secret

# App
# Connection string is assembled from the MariaDB vars above inside the container;
# override DATABASE_URL only for non-Docker local runs.
# DATABASE_URL=mysql+pymysql://pmsys:pmsys_secret@localhost:3306/pmsys
SECRET_KEY=change-me-in-production
DEBUG=false

# Port the app is exposed on the host
APP_PORT=8000